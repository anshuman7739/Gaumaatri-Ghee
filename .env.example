RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx

# Google Apps Script "Web App" URL (exec) + its secret token.
# REQUIRED for the Google Sheets mirror. There is no hardcoded fallback now, so
# if these are unset the mirror is simply disabled (visible in /api/health as
# "sheetsSet": false) instead of silently writing to the wrong script.
#
# The deployment MUST be created with:
#   Execute as:        Me
#   Who has access:    Anyone        <-- if not "Anyone", Google returns a 302
#                                        redirect to a login page and every sync
#                                        fails (this is the #1 cause of "orders
#                                        never appear in my sheet").
SHEETS_API_URL=https://script.google.com/macros/s/XXXX/exec
SHEETS_API_TOKEN=your_secret_token

# Admin API token (protects /api/admin/*, Influencer/coupon dashboards).
# Set a long random string in production.
ADMIN_TOKEN=change_me_to_a_long_random_string

# Order status-change confirmation emails (server-side, sent to the customer
# when an admin updates an order's status). Optional — if unset, emails are skipped.
# Get the Access Token (private key) from EmailJS -> Account -> API.
EMAILJS_ACCESS_TOKEN=your_emailjs_private_key
EMAILJS_SERVICE_ID=service_xxxxxxxx
EMAILJS_USER_ID=your_emailjs_public_key
EMAILJS_STATUS_TEMPLATE_ID=template_xxxxxxxx

# Durable data path for influencer/coupon DB.
# Set this explicitly in production or on any serverless host so manual coupons
# do not disappear after a cold start or container reset.
# Example: /var/data/influencers-data.json or ./data/influencers-data.json
INFLUENCER_DB_PATH=./data/influencers-data.json

# Optional Upstash Redis backup for serverless deployments.
# Use this if you deploy on Vercel and want coupon/admin data to survive cold starts.
# Example:
# UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_token
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Shared order store (serverless-safe persistence for Vercel — optional locally).
# Local dev uses the JSON file; set these in production so orders + status
# changes survive across serverless invocations (read-only disk otherwise).
# Any tiny HTTP JSON store works. Contract (POST JSON):
#   { secret, op: 'upsert', record } -> 200, { secret, op: 'list' } -> { records: [] }
ORDER_STORE_URL=
ORDER_STORE_SECRET=

PORT=3000
NODE_ENV=production

